    with open(csv_name, 'w', encoding='utf-8') as f:
        f.write(sample_data)
    print(f"✅ File contoh '{csv_name}' berhasil dibuat.\n")

# Baca data CSV
try:
    data = pd.read_csv(csv_name)
    print("✅ File berhasil dibaca!\n")
    print("Data awal:")
    print(data.head())
    print("\nInfo Data:")
    print(data.info())
except Exception as e:
    print("❌ Gagal membaca file CSV!")
    print(e)
    sys.exit(1)

# Hapus baris kosong jika ada
data = data.dropna()

# --- Bagian Grafik ---
print("\n🔍 Membuat grafik sebaran data gravitasi...")

try:
    x = data["X"]
    y = data["Y"]
    a = data["Anomali_Gravitasi_mGal"]

    plt.figure(figsize=(8, 6))
    scatter = plt.scatter(x, y, c=a, cmap="viridis", s=90, edgecolor="k")
    plt.colorbar(scatter, label="Anomali Gravitasi (mGal)")
    plt.xlabel("Koordinat X (m)")
    plt.ylabel("Koordinat Y (m)")
    plt.title("Sebaran Titik Survey Gravitasi")
    plt.grid(True, linestyle='--', alpha=0.5)

    # Simpan dan tampilkan
    plt.savefig("map_gravitasi.png", dpi=150)
    print("✅ Grafik disimpan sebagai 'map_gravitasi.png'")
    plt.show()

except Exception as e:
    print("❌ Terjadi kesalahan saat membuat grafik:")
    print(e)
    sys.exit(1)

print("\nSelesai ✅")

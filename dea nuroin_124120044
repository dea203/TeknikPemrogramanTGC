import os
import sys
import pandas as pd
import matplotlib.pyplot as plt

print("== Debug Info ==")
print("Python executable:", sys.executable)
print("Current working dir:", os.getcwd())
print("Files in working dir:")
for f in os.listdir('.'):
    print("  ", f)
print("=================\n")

# Nama file CSV yang mau dibaca
csv_name = "data survey gravitasi.csv"

# Kalau file belum ada, buat otomatis
if not os.path.isfile(csv_name):
    print(f"⚠️ File '{csv_name}' tidak ditemukan di folder ini.")
    print("Membuat file contoh otomatis...\n")

    sample_data = """X	Y	Elevasi	Anomali_Gravitasi_mGal
